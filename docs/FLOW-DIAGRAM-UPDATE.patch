+}
+#ao-studio .agent-flow-section .flow-heading p {
+  margin: 6px 0 0;
+  font-size: 12px;
+  color: var(--af-muted);
+}
+#ao-studio .agent-flow-section .flow-summary {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  white-space: nowrap;
+  color: #abd9d1;
+  background: rgba(66, 215, 198, 0.08);
+  border: 1px solid rgba(66, 215, 198, 0.18);
+  border-radius: 7px;
+  padding: 6px 10px;
+  font-size: 12px;
+}
+#ao-studio .agent-flow-section .flow-summary__dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--af-accent);
+}
+
+/* Board fixed geometric coordinates = SVG viewBox; scroll on narrow screens. */
+#ao-studio .agent-flow-section .flow-scroller {
+  width: 100%;
+  overflow-x: auto;
+  overflow-y: hidden;
+  scrollbar-width: thin;
+  scrollbar-color: #415269 transparent;
+  outline-offset: -3px;
+}
+#ao-studio .agent-flow-section .flow-scroller:focus-visible {
+  outline: 2px solid var(--af-accent);
+}
+#ao-studio .agent-flow-section .flow-board {
+  position: relative;
+  width: 1274px;
+  height: 428px;
+  margin: 0 auto;
+  isolation: isolate;
+  background-color: var(--af-board);
+  background-image: radial-gradient(rgba(126, 160, 187, 0.19) 0.8px, transparent 0.8px);
+  background-position: 1px 1px;
+  background-size: 16px 16px;
+}
+#ao-studio .agent-flow-section .flow-connections {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: 0;
+  pointer-events: none;
+  overflow: visible;
+}
+#ao-studio .agent-flow-section .flow-connections__base path {
+  fill: none;
+  stroke: var(--af-line);
+  stroke-width: 2;
+  stroke-linecap: round;
+  opacity: 0.78;
+}
+#ao-studio .agent-flow-section .flow-path {
+  fill: none;
+  stroke: var(--af-accent);
