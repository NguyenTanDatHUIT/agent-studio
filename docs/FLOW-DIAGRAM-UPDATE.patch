+  color: var(--af-text);
+  font-family: inherit;
+  border: 1px solid var(--af-border);
+  border-radius: 14px;
+  overflow: hidden;
+}
+
+#ao-studio .agent-flow-section * { box-sizing: border-box; }
+
+#ao-studio .agent-flow-section .flow-heading {
+  display: flex;
